{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",               // Enable relative base
    "paths": {
      "@imports/*": ["imports/*"] // Alias for imports directory
    },
    "esModuleInterop": true,
    "strict": true
  },
  "include": [
    "types/*",
    "imports/**/*",
    "packages/**/*"
  ]
}